---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { path } from '../utils/base';
import '@styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = '信息学奥赛专业培训，培养孩子的计算思维与算法能力', ogImage } = Astro.props;
const fullTitle = `${title} | 牛油果零壹信奥`;
const resolvedOgImage = ogImage ? path(ogImage) : path('/og-image.png');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={resolvedOgImage} />

    <link rel="icon" type="image/svg+xml" href={path('/favicon.svg')} />

    <title>{fullTitle}</title>

    <!-- 百度统计 -->
    <script is:inline>
      var _hmt = _hmt || [];
      (function () {
        var hm = document.createElement('script');
        hm.src = 'https://hm.baidu.com/hm.js?b949ee08f105e436e0064dc163103cd1';
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
